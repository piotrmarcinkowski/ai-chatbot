{
    "name": "ai-chatbot-devcontainer",
    "initializeCommand": "cp ${localWorkspaceFolder}/env/devcontainer.env ${localWorkspaceFolder}/.devcontainer/.env",
    "dockerComposeFile": [
        "docker-compose.devcontainer.yml"
    ],
    "service": "ai-chatbot",
    "workspaceFolder": "/ai-chatbot",
    "runServices": ["ai-chatbot"],
    "mounts": [
      "source=${localWorkspaceFolder},target=/ai-chatbot,type=bind",
      "source=${localWorkspaceFolder}/.devcontainer/.vscode,target=/ai-chatbot/.vscode,type=bind"
    ],
    "remoteUser": "chatbot",
    "forwardPorts": [2024],
    "remoteEnv": {

    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-python.pylint",
                "hediet.vscode-drawio",
                "GitHub.vscode-pull-request-github",
                "mongodb.mongodb-vscode",
                "Gruntfuggly.todo-tree",
                "wayou.vscode-todo-highlight",
                "ms-python.black-formatter",
                "GitHub.copilot"
            ]
        }
    }
  }
