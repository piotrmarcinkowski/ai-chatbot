{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LangGraph Dev (langgraph_dev_runner.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/src/langgraph_dev_runner.py",
      "python": "/usr/local/bin/python3",
      "envFile": "${workspaceFolder}/.env",
      "console": "internalConsole"
    },
    {
      "name": "CLI Debug (cli_runner.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app/src/cli_runner.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/app/src",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/app/src"
      },
      "justMyCode": false
    },
    {
      "name": "UI - CLI Client",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/ui/cli/chatbot_cli.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/ui/cli",
    },
    {
      "name": "UI - Streamlit",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
          "run",
          "app.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/ui/streamlit",
    }
  ]
}
