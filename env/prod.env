COMPOSE_PROJECT_NAME=ai-chatbot-prod
COMPOSE_PROFILES=prod
BACKEND_PORT=8124
SERVER_URL=http://localhost:8124
LANGGRAPH_SERVER_URL=http://localhost:8124
MONGO_DB=ai_chatbot_prod
BACKEND_IMAGE=ai-chatbot-prod:latest
BACKEND_BUILD_TARGET=ai-chatbot-dev
ENV_FILE=env/prod.env
REDIS_URI=redis://redis:6379
DATABASE_URI=postgresql://langgraph:langgraph@postgres:5432/langgraph
